 "fields": [
  {
   "fieldname": "section_break_config",
   "fieldtype": "Section Break",
   "label": "Release Configuration"
  },
  {
   "fieldname": "release_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Release Name",
   "reqd": 1,
   "description": "The Helm release name. Must be unique within the target cluster and namespace."
  },
  {
   "fieldname": "cluster",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Target Cluster",
   "options": "Kubernetes Cluster",
   "reqd": 1
  },
  {
   "default": "default",
   "fieldname": "namespace",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Namespace",
   "reqd": 1
  },
  {
   "fieldname": "column_break_chart",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "chart",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Chart",
   "options": "Helm Chart",
   "reqd": 1,
   "description": "The Helm chart to deploy."
  },
  {
   "fieldname": "chart_version",
   "fieldtype": "Data",
   "label": "Chart Version",
   "description": "The specific chart version to install. Leave blank for the latest version.",
   "depends_on": "chart"
  },
  {
   "fieldname": "site_image",
   "fieldtype": "Link",
   "label": "Site Image",
   "options": "Kubeport Site Image",
   "description": "Optional Kubeport-owned Frappe/ERPNext runtime image. When set, Kubeport injects image.repository, image.tag, and image.pullPolicy into Helm values during deploy.",
   "depends_on": "chart"
  },
  {
   "fieldname": "site_image_detail",
   "fieldtype": "HTML",
   "label": "Site Image Detail",
   "depends_on": "site_image"
  },
  {
   "fieldname": "section_break_values",
   "fieldtype": "Section Break",
   "label": "Values Override"
  },
  {
   "fieldname": "load_defaults",
   "fieldtype": "Button",
   "label": "Load Default Values",
   "button_color": "Default",
   "description": "Fetch the default values.yaml from the selected chart and populate the editor below."
  },
  {
   "fieldname": "values",
   "fieldtype": "Code",
   "label": "Values",
   "options": "YAML",
   "description": "YAML values to override chart defaults. Equivalent to helm install --values."
  },
  {
   "fieldname": "section_break_ingress",
   "fieldtype": "Section Break",
   "label": "Ingress",
   "depends_on": "eval:doc.chart",
   "description": "Frappe/ERPNext charts only. For other charts, configure ingress via raw values YAML above."
  },
  {
   "default": "0",
   "fieldname": "ingress_enabled",
   "fieldtype": "Check",
   "label": "Enable Ingress",
   "description": "Render ingress.* into Helm values. Has no effect for non-Frappe charts."
  },
  {
   "fieldname": "ingress_hostname",
   "fieldtype": "Data",
   "label": "Hostname",
   "depends_on": "eval:doc.ingress_enabled",
   "mandatory_depends_on": "eval:doc.ingress_enabled",
   "description": "External hostname (e.g. erp.example.com). Becomes ingress.hosts[0].host."
  },
  {
   "fieldname": "column_break_ingress",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "ingress_class_name",
   "fieldtype": "Data",
   "label": "Ingress Class",
   "depends_on": "eval:doc.ingress_enabled",
   "description": "IngressClass name (e.g. nginx). Leave blank to use the cluster's default IngressClass."
  },
  {
   "fieldname": "ingress_cluster_issuer",
   "fieldtype": "Data",
   "label": "cert-manager ClusterIssuer",
   "depends_on": "eval:doc.ingress_enabled",
   "description": "Optional. When set, renders cert-manager.io/cluster-issuer annotation and a TLS block referencing secret <release-name>-tls. Leave blank for HTTP-only."
  },
  {
   "fieldname": "section_break_database",
   "fieldtype": "Section Break",
   "label": "Database",
   "depends_on": "eval:doc.chart",
   "description": "Frappe/ERPNext charts only. By default Kubeport bundles a per-release MariaDB so site creation works out of the box."
  },
  {
   "default": "0",
   "fieldname": "use_external_database",
   "fieldtype": "Check",
   "label": "Use External Database",
   "description": "When checked, Kubeport will not auto-bundle MariaDB. You must supply 'dbHost' (and root credentials via the Frappe Site form) yourself. Has no effect for non-Frappe charts."
  },
  {
   "fieldname": "section_break_actions",
   "fieldtype": "Section Break",
   "label": "Actions"
  },
  {
   "button_color": "Primary",
   "fieldname": "deploy_release",
   "fieldtype": "Button",
   "label": "Install / Upgrade"
  },
  {
   "button_color": "Primary",
   "fieldname": "uninstall_release",
   "fieldtype": "Button",
   "label": "Uninstall"
  },
  {
   "button_color": "Default",
   "fieldname": "show_history",
   "fieldtype": "Button",
   "label": "History / Rollback"
  },
  {
   "fieldname": "section_break_status",
   "fieldtype": "Section Break",
   "label": "Release Status"
  },
  {
   "default": "Draft",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Status",
   "options": "Draft\nIn Progress\nDeployed\nDegraded\nUninstalling\nFailed",
   "read_only": 1
  },
  {
   "default": "0",
   "fieldname": "pending_changes",
   "fieldtype": "Check",
   "label": "Pending Changes",
   "read_only": 1,
   "description": "Checked when the saved desired state differs from the last successfully applied Helm spec."
  },
  {
   "fieldname": "operation_type",
   "fieldtype": "Select",
   "label": "Current Operation",
   "options": "\nDeploy\nUpgrade\nRollback\nUninstall",
   "read_only": 1,
   "description": "The in-flight Helm operation, if any."
  },
  {
   "fieldname": "operation_started_at",
   "fieldtype": "Datetime",
   "label": "Operation Started At",
   "read_only": 1
  },
  {
   "fieldname": "column_break_status",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
   "fieldname": "helm_revision",
   "fieldtype": "Int",
   "label": "Revision",
   "read_only": 1,
   "description": "The Helm release revision number."
  },
  {
   "fieldname": "last_applied_chart_version",
   "fieldtype": "Data",
   "label": "Last Applied Chart Version",
   "read_only": 1
  },
  {
   "fieldname": "helm_status_detail",
   "fieldtype": "Small Text",
   "label": "Status Detail",
   "read_only": 1,
   "description": "Detailed status information from the Helm CLI."
  },
